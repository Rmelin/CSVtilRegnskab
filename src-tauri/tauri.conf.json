{
  "productName": "Foreningsregnskab",
  "version": "0.1.0",
  "identifier": "dk.forening.regnskab",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../frontend/dist"
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Foreningsregnskab",
        "width": 1200,
        "height": 800
      }
    ]
  }
}
